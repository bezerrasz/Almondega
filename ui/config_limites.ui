  <property name="styleSheet">
   <string notr="true">/* Pinta o fundo da janela de cinza escuro */
QDialog {
    background-color: #2b2b2b;
}

/* Pinta todos os textos de branco e deixa em negrito */
QLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
}

/* Estiliza as caixinhas preservando as setinhas nativas (Sem bordas e sem padding!) */
QSpinBox, QDoubleSpinBox {
    background-color: #1e1e1e;
    color: #ffffff;
    font-size: 14px;
}

/* Quando você clica na caixinha para digitar (Foco), clareia o fundo em vez de criar borda */
QSpinBox:focus, QDoubleSpinBox:focus {
    background-color: #3a3a3a; 
}

/* Estiliza o botão de Salvar */
QPushButton {
    background-color: #00aa00; 
    color: white;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
}

/* Quando passa o mouse por cima do botão, ele fica com um verde mais claro */
QPushButton:hover {
    background-color: #00cc00; 
}</string>
