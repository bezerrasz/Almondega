   <string notr="true">/* Fundo escuro */
QDialog {
    background-color: #2b2b2b;
}

/* Rótulos de texto */
QLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
}

/* Caixas de seleção e número */
QComboBox, QSpinBox {
    background-color: #1e1e1e;
    color: #ffffff;
    padding: 5px;
    border-radius: 4px;
}

QComboBox:focus, QSpinBox:focus {
    background-color: #3a3a3a;
}

/* Botões */
QPushButton {
    background-color: #008cba;
    color: white;
    border-radius: 6px;
    padding: 8px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #005f73;
}

QPushButton:disabled {
    background-color: #555555;
    color: #888888;
}</string>
